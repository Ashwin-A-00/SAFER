@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:     <http://example.org/credit#> .

# ── Mapping for original applicant ───────────────────────────────────────────

<#OriginalMapping>
    rml:logicalSource [
        rml:source "C:\\TEST\\KG\\rml\\original.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://example.org/credit/applicant/{instance_id}" ;
        rr:class ex:CreditApplicant
    ] ;

    rr:predicateObjectMap [ rr:predicate ex:checkingAccountStatus ;
        rr:objectMap [ rml:reference "checking_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:duration ;
        rr:objectMap [ rml:reference "duration" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditHistory ;
        rr:objectMap [ rml:reference "credit_history" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:loanPurpose ;
        rr:objectMap [ rml:reference "purpose" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditAmount ;
        rr:objectMap [ rml:reference "credit_amount" ; rr:datatype xsd:decimal ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:savingsStatus ;
        rr:objectMap [ rml:reference "savings_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:employmentSince ;
        rr:objectMap [ rml:reference "employment" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:installmentRate ;
        rr:objectMap [ rml:reference "installment_rate" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:personalStatus ;
        rr:objectMap [ rml:reference "personal_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:otherDebtors ;
        rr:objectMap [ rml:reference "other_debtors" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:residenceSince ;
        rr:objectMap [ rml:reference "residence_since" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:propertyType ;
        rr:objectMap [ rml:reference "property" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:age ;
        rr:objectMap [ rml:reference "age" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:otherInstallmentPlans ;
        rr:objectMap [ rml:reference "other_installment_plans" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:housingStatus ;
        rr:objectMap [ rml:reference "housing" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:existingCredits ;
        rr:objectMap [ rml:reference "existing_credits" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:jobType ;
        rr:objectMap [ rml:reference "job" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:numberOfDependents ;
        rr:objectMap [ rml:reference "num_dependents" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:telephone ;
        rr:objectMap [ rml:reference "telephone" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:foreignWorker ;
        rr:objectMap [ rml:reference "foreign_worker" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditRisk ;
        rr:objectMap [ rml:reference "target" ; rr:datatype xsd:integer ] ] .

# ── Mapping for CF applicants ─────────────────────────────────────────────────

<#CFApplicantMapping>
    rml:logicalSource [
        rml:source "C:\\TEST\\KG\\rml\\counterfactuals.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://example.org/credit/applicant/{instance_id}" ;
        rr:class ex:CreditApplicant
    ] ;

    rr:predicateObjectMap [ rr:predicate ex:checkingAccountStatus ;
        rr:objectMap [ rml:reference "checking_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:duration ;
        rr:objectMap [ rml:reference "duration" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditHistory ;
        rr:objectMap [ rml:reference "credit_history" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:loanPurpose ;
        rr:objectMap [ rml:reference "purpose" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditAmount ;
        rr:objectMap [ rml:reference "credit_amount" ; rr:datatype xsd:decimal ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:savingsStatus ;
        rr:objectMap [ rml:reference "savings_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:employmentSince ;
        rr:objectMap [ rml:reference "employment" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:installmentRate ;
        rr:objectMap [ rml:reference "installment_rate" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:personalStatus ;
        rr:objectMap [ rml:reference "personal_status" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:otherDebtors ;
        rr:objectMap [ rml:reference "other_debtors" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:residenceSince ;
        rr:objectMap [ rml:reference "residence_since" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:propertyType ;
        rr:objectMap [ rml:reference "property" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:age ;
        rr:objectMap [ rml:reference "age" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:otherInstallmentPlans ;
        rr:objectMap [ rml:reference "other_installment_plans" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:housingStatus ;
        rr:objectMap [ rml:reference "housing" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:existingCredits ;
        rr:objectMap [ rml:reference "existing_credits" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:jobType ;
        rr:objectMap [ rml:reference "job" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:numberOfDependents ;
        rr:objectMap [ rml:reference "num_dependents" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:telephone ;
        rr:objectMap [ rml:reference "telephone" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:foreignWorker ;
        rr:objectMap [ rml:reference "foreign_worker" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:creditRisk ;
        rr:objectMap [ rml:reference "target" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:isCounterfactualOf ;
        rr:objectMap [
            rr:constant <http://example.org/credit/applicant/original_289>
        ]
    ] .

# ── Mapping for CF explanation nodes ─────────────────────────────────────────

<#CFExplanationMapping>
    rml:logicalSource [
        rml:source "C:\\TEST\\KG\\rml\\counterfactuals.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://example.org/credit/explanation/{instance_id}" ;
        rr:class ex:CounterfactualExplanation
    ] ;

    rr:predicateObjectMap [ rr:predicate ex:cfIndex ;
        rr:objectMap [ rml:reference "cf_index" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:explainedInstance ;
        rr:objectMap [ rr:constant <http://example.org/credit/applicant/original_289> ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:generatedBy ;
        rr:objectMap [ rr:template "http://example.org/credit#{method}" ; rr:termType rr:IRI ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:approvalProbability ;
        rr:objectMap [ rml:reference "approval_probability" ; rr:datatype xsd:decimal ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:datasetName ;
        rr:objectMap [ rml:reference "dataset_name" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:modelType ;
        rr:objectMap [ rml:reference "model_type" ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:sparsityScore ;
        rr:objectMap [ rml:reference "sparsity_score" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:proximityScore ;
        rr:objectMap [ rml:reference "proximity_score" ; rr:datatype xsd:decimal ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:immutableViolations ;
        rr:objectMap [ rml:reference "immutable_violations" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:directionViolations ;
        rr:objectMap [ rml:reference "direction_violations" ; rr:datatype xsd:integer ] ] ;

    rr:predicateObjectMap [ rr:predicate ex:generationTime ;
        rr:objectMap [ rml:reference "generation_time" ; rr:datatype xsd:decimal ] ] .       