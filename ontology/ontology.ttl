@prefix : <http://example.org/credit#GermanCreditOntology> .
@prefix ex: <http://example.org/credit#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@base <http://example.org/credit#GermanCreditOntology> .

<http://example.org/credit#GermanCreditOntology> rdf:type owl:Ontology ;
                                                  owl:imports <http://example.org/credit#GermanCreditOntology> ;
                                                  rdfs:comment "Ontology for the German Credit dataset for counterfactual generation and RDF conversion." ;
                                                  rdfs:label "German Credit Risk Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/credit#explainedInstance
ex:explainedInstance rdf:type owl:ObjectProperty ;
                     rdfs:domain ex:CounterfactualExplanation ;
                     rdfs:range ex:CreditApplicant ;
                     rdfs:comment "The original rejected applicant this CF was generated for." ;
                     rdfs:label "explained instance" .


###  http://example.org/credit#generatedBy
ex:generatedBy rdf:type owl:ObjectProperty ;
               rdfs:domain ex:CounterfactualExplanation ;
               rdfs:range owl:NamedIndividual ;
               rdfs:comment "The method used to generate this counterfactual explanation." ;
               rdfs:label "generated by" .


###  http://example.org/credit#isCounterfactualOf
ex:isCounterfactualOf rdf:type owl:ObjectProperty ;
                      rdfs:domain ex:CreditApplicant ;
                      rdfs:range ex:CreditApplicant ;
                      rdfs:comment "Links a CF applicant instance to the original rejected applicant." ;
                      rdfs:label "is counterfactual of" .


#################################################################
#    Data properties
#################################################################

###  http://example.org/credit#age
ex:age rdf:type owl:DatatypeProperty ;
       rdfs:domain ex:CreditApplicant ;
       rdfs:range xsd:integer ;
       rdfs:comment "Age of the applicant in years." ;
       rdfs:label "age" .


###  http://example.org/credit#approvalProbability
ex:approvalProbability rdf:type owl:DatatypeProperty ;
                       rdfs:domain ex:CounterfactualExplanation ;
                       rdfs:range xsd:decimal ;
                       rdfs:comment "Predicted probability of loan approval for this counterfactual." ;
                       rdfs:label "approval probability" .


###  http://example.org/credit#cfIndex
ex:cfIndex rdf:type owl:DatatypeProperty ;
           rdfs:domain ex:CounterfactualExplanation ;
           rdfs:range xsd:integer ;
           rdfs:comment "Index of this counterfactual in the generated set (1-5)." ;
           rdfs:label "CF index" .


###  http://example.org/credit#checkingAccountStatus
ex:checkingAccountStatus rdf:type owl:DatatypeProperty ;
                         rdfs:domain ex:CreditApplicant ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Status of existing checking account. A11:<0DM, A12:0-200DM, A13:>=200DM, A14:no account." ;
                         rdfs:label "checking account status" .


###  http://example.org/credit#creditAmount
ex:creditAmount rdf:type owl:DatatypeProperty ;
                rdfs:domain ex:CreditApplicant ;
                rdfs:range xsd:decimal ;
                rdfs:comment "Amount of credit requested in DM." ;
                rdfs:label "credit amount" .


###  http://example.org/credit#creditHistory
ex:creditHistory rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:CreditApplicant ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Credit history code. A30-A34." ;
                 rdfs:label "credit history" .


###  http://example.org/credit#creditRisk
ex:creditRisk rdf:type owl:DatatypeProperty ;
              rdfs:domain ex:CreditApplicant ;
              rdfs:range xsd:integer ;
              rdfs:comment "Credit risk classification. 1:good, 2:bad." ;
              rdfs:label "credit risk" .


###  http://example.org/credit#datasetName
ex:datasetName rdf:type owl:DatatypeProperty ;
               rdfs:domain ex:CounterfactualExplanation ;
               rdfs:range xsd:string ;
               rdfs:comment "Name of the dataset used. e.g. GermanCredit, Adult, COMPAS" ;
               rdfs:label "dataset name" .


###  http://example.org/credit#directionViolations
ex:directionViolations rdf:type owl:DatatypeProperty ;
                       rdfs:domain ex:CounterfactualExplanation ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "Number of features changed in wrong direction. Must be 0." ;
                       rdfs:label "direction violations" .


###  http://example.org/credit#duration
ex:duration rdf:type owl:DatatypeProperty ;
            rdfs:domain ex:CreditApplicant ;
            rdfs:range xsd:integer ;
            rdfs:comment "Duration of the loan in months." ;
            rdfs:label "duration" .


###  http://example.org/credit#employmentSince
ex:employmentSince rdf:type owl:DatatypeProperty ;
                   rdfs:domain ex:CreditApplicant ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Present employment duration. A71:unemployed, A72:<1yr, A73:1-4yr, A74:4-7yr, A75:>=7yr." ;
                   rdfs:label "employment since" .


###  http://example.org/credit#existingCredits
ex:existingCredits rdf:type owl:DatatypeProperty ;
                   rdfs:domain ex:CreditApplicant ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Number of existing credits at this bank." ;
                   rdfs:label "existing credits" .


###  http://example.org/credit#foreignWorker
ex:foreignWorker rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:CreditApplicant ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Is the applicant a foreign worker. A201:yes, A202:no." ;
                 rdfs:label "foreign worker" .


###  http://example.org/credit#generationTime
ex:generationTime rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:CounterfactualExplanation ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Time taken to generate this CF in seconds." ;
                  rdfs:label "generation time" .


###  http://example.org/credit#housingStatus
ex:housingStatus rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:CreditApplicant ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Housing situation. A151:rent, A152:own, A153:free." ;
                 rdfs:label "housing status" .


###  http://example.org/credit#immutableViolations
ex:immutableViolations rdf:type owl:DatatypeProperty ;
                       rdfs:domain ex:CounterfactualExplanation ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "Number of immutable features changed. Must be 0." ;
                       rdfs:label "immutable violations" .


###  http://example.org/credit#installmentRate
ex:installmentRate rdf:type owl:DatatypeProperty ;
                   rdfs:domain ex:CreditApplicant ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Installment rate as percentage of disposable income (1-4)." ;
                   rdfs:label "installment rate" .


###  http://example.org/credit#jobType
ex:jobType rdf:type owl:DatatypeProperty ;
           rdfs:domain ex:CreditApplicant ;
           rdfs:range xsd:string ;
           rdfs:comment "Job category. A171:unemployed non-resident, A172:unskilled resident, A173:skilled, A174:management." ;
           rdfs:label "job type" .


###  http://example.org/credit#loanPurpose
ex:loanPurpose rdf:type owl:DatatypeProperty ;
               rdfs:domain ex:CreditApplicant ;
               rdfs:range xsd:string ;
               rdfs:comment "Purpose of the loan. A40-A410." ;
               rdfs:label "loan purpose" .


###  http://example.org/credit#modelType
ex:modelType rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:CounterfactualExplanation ;
             rdfs:range xsd:string ;
             rdfs:comment "Type of ML model explained. e.g. RandomForest, XGBoost" ;
             rdfs:label "model type" .


###  http://example.org/credit#numberOfDependents
ex:numberOfDependents rdf:type owl:DatatypeProperty ;
                      rdfs:domain ex:CreditApplicant ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Number of people liable to provide maintenance for." ;
                      rdfs:label "number of dependents" .


###  http://example.org/credit#otherDebtors
ex:otherDebtors rdf:type owl:DatatypeProperty ;
                rdfs:domain ex:CreditApplicant ;
                rdfs:range xsd:string ;
                rdfs:comment "Other debtors or guarantors. A101:none, A102:co-applicant, A103:guarantor." ;
                rdfs:label "other debtors" .


###  http://example.org/credit#otherInstallmentPlans
ex:otherInstallmentPlans rdf:type owl:DatatypeProperty ;
                         rdfs:domain ex:CreditApplicant ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Other installment plans. A141:bank, A142:stores, A143:none." ;
                         rdfs:label "other installment plans" .


###  http://example.org/credit#personalStatus
ex:personalStatus rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:CreditApplicant ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Personal status and sex. A91-A95." ;
                  rdfs:label "personal status" .


###  http://example.org/credit#propertyType
ex:propertyType rdf:type owl:DatatypeProperty ;
                rdfs:domain ex:CreditApplicant ;
                rdfs:range xsd:string ;
                rdfs:comment "Most valuable property. A121:real estate, A122:life insurance, A123:car, A124:unknown." ;
                rdfs:label "property type" .


###  http://example.org/credit#proximityScore
ex:proximityScore rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:CounterfactualExplanation ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "L1 distance between CF and original on numeric features. Lower is better." ;
                  rdfs:label "proximity score" .


###  http://example.org/credit#residenceSince
ex:residenceSince rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:CreditApplicant ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Number of years at present residence (1-4)." ;
                  rdfs:label "residence since" .


###  http://example.org/credit#savingsStatus
ex:savingsStatus rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:CreditApplicant ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Savings account/bonds status. A61:<100DM, A62:100-500DM, A63:500-1000DM, A64:>=1000DM, A65:unknown." ;
                 rdfs:label "savings status" .


###  http://example.org/credit#sparsityScore
ex:sparsityScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:CounterfactualExplanation ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Number of features changed. Lower is better." ;
                 rdfs:label "sparsity score" .


###  http://example.org/credit#telephone
ex:telephone rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:CreditApplicant ;
             rdfs:range xsd:string ;
             rdfs:comment "Telephone registered. A191:none, A192:yes." ;
             rdfs:label "telephone" .


#################################################################
#    Classes
#################################################################

###  http://example.org/credit#CounterfactualExplanation
ex:CounterfactualExplanation rdf:type owl:Class ;
                             rdfs:comment "A counterfactual explanation generated for a rejected credit applicant." ;
                             rdfs:label "Counterfactual Explanation" .


###  http://example.org/credit#CreditApplicant
ex:CreditApplicant rdf:type owl:Class ;
                   rdfs:comment "A person who has applied for a credit loan." ;
                   rdfs:label "Credit Applicant" .


###  http://www.w3.org/2002/07/owl#NamedIndividual
owl:NamedIndividual rdf:type owl:Class .


